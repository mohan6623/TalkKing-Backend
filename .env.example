# .env.example

# Environment
ENVIRONMENT=development  # production | staging | development

# Supabase (Managed — zero VM load)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=eyJ...anon-key

# AI APIs (Free Tiers)
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxx
HUME_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Redis (local — on VM)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# CORS
CORS_ORIGINS=["https://talkking.me","https://www.talkking.me","http://localhost:5173"]

# Monitoring (GitHub Student Pack)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Email (Mailgun — Student Pack)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.talkking.me
